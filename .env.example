# Civil News Hub - Server Environment Configuration
PORT=5000
GEMINI_MODEL=gemini-1.5-flash
# Google Gemini API Key (발급: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Naver Search Open API (발급: https://developers.naver.com/apps/#/register)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao REST API (발급: https://developers.kakao.com)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Telegram 아침 Top 5 다이제스트 (daily_digest.py) - @BotFather 로 봇 생성 후 토큰 입력, chat_id 는 --get-chat-id 로 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
